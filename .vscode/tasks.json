{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "export PATH=\"$HOME/.local/bin:$HOME/.platformio/penv/bin:$PATH\"; pio run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Build and Flash",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "export PATH=\"$HOME/.local/bin:$HOME/.platformio/penv/bin:$PATH\"; pio run -t upload"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Serial Monitor",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "export PATH=\"$HOME/.local/bin:$HOME/.platformio/penv/bin:$PATH\"; pio device monitor"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Build, Flash, and Serial",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "export PATH=\"$HOME/.local/bin:$HOME/.platformio/penv/bin:$PATH\"; pio run -t upload -t monitor"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        }
    ]
}
